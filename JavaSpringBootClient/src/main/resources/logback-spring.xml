<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console Appender - ALWAYS ACTIVE (not just for dev profile) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%X{correlationId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root Logger - ALWAYS ACTIVE -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Set DEBUG level for our application package -->
    <logger name="com.robot.warehouse" level="DEBUG"/>

    <!-- Dev Profile: Additional JSON File Logging -->
    <springProfile name="dev">
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/warehouse-gripper.json</file>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdc>true</includeMdc>
                <customFields>{"application":"warehouse-gripper"}</customFields>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/warehouse-gripper.%d{yyyy-MM-dd}.json</fileNamePattern>
                <maxHistory>30</maxHistory>
            </rollingPolicy>
        </appender>

        <root level="DEBUG">
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>

</configuration>